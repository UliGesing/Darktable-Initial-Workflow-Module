msgstr "Workflow wurde abgebrochen"

#: lib/IWF_WorkflowButtons.lua:107
msgid "workflow canceled - darktable shutting down"
msgstr "Workflow wurde abgebrochen - darktable wird beendet"

#: lib/IWF_WorkflowButtons.lua:132
